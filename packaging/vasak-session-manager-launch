#!/bin/bash
# VasakOS greeter launcher — invoked by greetd (as the unprivileged `greeter`
# user) via /etc/greetd/config.toml. Hosts the Tauri greeter inside Cage, a
# minimal kiosk Wayland compositor. greetd sets GREETD_SOCK in the environment,
# which the greeter uses to drive authentication/session start.

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=VasakOS

# ── Keyboard layout ──────────────────────────────────────────────────────────
# Cage is a wlroots compositor and takes its keymap from XKB_DEFAULT_*. Without
# these it defaults to US QWERTY no matter how the machine is configured, so
# anyone with a non-US keyboard types a different password than the one they
# see and simply cannot log in. The layout has to be resolved here, in the
# compositor's environment: the greeter itself cannot change a keymap.
#
# /etc/X11/xorg.conf.d/00-keyboard.conf is what localectl writes and is
# authoritative for XKB. /etc/vconsole.conf is the console keymap and is only a
# fallback, since its names do not always match XKB layout names.

read_xkb_option() {
    local key="$1" file="/etc/X11/xorg.conf.d/00-keyboard.conf"
    [ -r "$file" ] || return 1
    sed -n -E "s/^[[:space:]]*Option[[:space:]]+\"${key}\"[[:space:]]+\"([^\"]*)\".*/\1/Ip" \
        "$file" | head -n 1
}

XKB_DEFAULT_LAYOUT="$(read_xkb_option XkbLayout)"
XKB_DEFAULT_VARIANT="$(read_xkb_option XkbVariant)"
XKB_DEFAULT_MODEL="$(read_xkb_option XkbModel)"
XKB_DEFAULT_OPTIONS="$(read_xkb_option XkbOptions)"

if [ -z "$XKB_DEFAULT_LAYOUT" ] && [ -r /etc/vconsole.conf ]; then
    # KEYMAP names mostly match XKB layouts for the common cases; strip the
    # variant suffixes the console uses ("es-dvorak", "fr.map.gz").
    keymap="$(sed -n -E 's/^[[:space:]]*KEYMAP=["]?([^"#[:space:]]+).*/\1/p' \
        /etc/vconsole.conf | head -n 1)"
    XKB_DEFAULT_LAYOUT="${keymap%%-*}"
fi

# Offer a US layout alongside a non-US one, switchable with both Shift keys.
# A password typed on an unexpected layout is invisible in a password field, so
# leaving an escape hatch is worth more than a strictly faithful keymap.
if [ -n "$XKB_DEFAULT_LAYOUT" ] && [ "$XKB_DEFAULT_LAYOUT" != "us" ]; then
    XKB_DEFAULT_LAYOUT="${XKB_DEFAULT_LAYOUT},us"
    XKB_DEFAULT_OPTIONS="${XKB_DEFAULT_OPTIONS:+${XKB_DEFAULT_OPTIONS},}grp:shifts_toggle"
fi

[ -n "$XKB_DEFAULT_LAYOUT" ] && export XKB_DEFAULT_LAYOUT
[ -n "$XKB_DEFAULT_VARIANT" ] && export XKB_DEFAULT_VARIANT
[ -n "$XKB_DEFAULT_MODEL" ] && export XKB_DEFAULT_MODEL
[ -n "$XKB_DEFAULT_OPTIONS" ] && export XKB_DEFAULT_OPTIONS

# ── Somewhere to write ───────────────────────────────────────────────────────
# greetd starts the greeter with a minimal environment, and WebKit refuses to
# start without a writable data directory — which is a failed window, which
# Tauri turns into a panic before anything is drawn. The symptom to look for is
# paths beginning with a double slash ("//.cache"), which is what an empty HOME
# expands to.
if [ -z "$HOME" ] || [ ! -w "$HOME" ]; then
    HOME="$(getent passwd "$(id -un)" | cut -d: -f6)"
    [ -n "$HOME" ] && [ -w "$HOME" ] || HOME=/tmp/vasak-greeter-$(id -u)
    export HOME
fi
mkdir -p "$HOME"

export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_CONFIG_HOME"

# systemd needs this to exist for a session that is not a logind one.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
[ -d "$XDG_RUNTIME_DIR" ] || { XDG_RUNTIME_DIR="$HOME/run"; mkdir -p "$XDG_RUNTIME_DIR"; chmod 700 "$XDG_RUNTIME_DIR"; export XDG_RUNTIME_DIR; }

# The greeter writes what it says here; greetd captures it into its journal, so
# a failure to start is readable with `journalctl -u greetd` instead of only
# being visible as text flashing past on the console.
exec cage -s -- /usr/bin/vasak-session-manager
