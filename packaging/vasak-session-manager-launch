#!/bin/bash
# VasakOS greeter launcher — invoked by greetd (as the unprivileged `greeter`
# user) via /etc/greetd/config.toml. Hosts the Tauri greeter inside Cage, a
# minimal kiosk Wayland compositor. greetd sets GREETD_SOCK in the environment,
# which the greeter uses to drive authentication/session start.

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=VasakOS

# -s: allow running without a controlling tty.
exec cage -s -- /usr/bin/vasak-session-manager
