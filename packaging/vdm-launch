#!/bin/bash
# VDM Launcher
# Runs the VasakOS Display Manager inside Cage (Wayland Compositor)

# Ensure reasonable environment for the greeter
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=VasakOS

# Run Cage with the VDM binary
# -s: Allow executing the command even if not on a tty (useful for systemd)
# We assume 'cage' is installed. 
exec cage -s -- /usr/bin/vdm
